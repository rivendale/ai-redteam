{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "redteam findings block, schema versions 2.2 and 2.3",
  "description": "The machine-readable JSON block at the end of a redteam or pr-review report. Written from the v2.2 and v2.3 sections of docs/SPEC.md. A 2.2 report is validated as before; a 2.3 report also needs the boundary, siblings_searched and reason rules (all additive). Rules that compare fields across the report (the verdict against the findings, unique ids, a refuted id absent from findings) are in tools/validate_findings.py, not here.",
  "type": "object",
  "required": ["schema_version", "verdict", "inputs_ledger", "coverage", "findings", "refuted"],
  "properties": {
    "schema_version": {"enum": ["2.2", "2.3"]},
    "verdict": {"enum": ["SHIP", "SHIP WITH FIXES", "REWORK", "REJECT"]},
    "confidence": {"enum": ["high", "medium", "low"]},
    "inputs_ledger": {"type": "array", "items": {"$ref": "#/$defs/ledgerItem"}},
    "coverage": {"$ref": "#/$defs/coverage"},
    "seats": {"type": "array"},
    "sensitivity_gate": {"type": "object"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "refuted": {"type": "array", "items": {"$ref": "#/$defs/refutedItem"}}
  },
  "allOf": [
    {"if": {"required": ["schema_version"], "properties": {"schema_version": {"const": "2.3"}}}, "then": {"$ref": "#/$defs/v23"}}
  ],
  "$defs": {
    "v23": {
      "description": "What schema 2.3 adds to 2.2. Coverage reasons come from a closed list; a confirmed High or Critical finding says whether it is a security finding, what was searched for siblings of it, and, if it is a security finding, the boundary it crosses.",
      "type": "object",
      "properties": {
        "coverage": {"properties": {"not_checked": {"items": {"properties": {"reason": {"enum": ["not_supplied", "not_read", "no_tools", "out_of_scope", "time_budget", "other"]}}}}}},
        "findings": {"items": {"$ref": "#/$defs/finding23"}}
      }
    },
    "finding23": {
      "type": "object",
      "allOf": [
        {"if": {"required": ["status", "severity"], "properties": {"status": {"const": "confirmed"}, "severity": {"enum": ["High", "Critical"]}}},
         "then": {"required": ["security", "siblings_searched"]}},
        {"if": {"required": ["security"], "properties": {"security": {"const": true}}}, "then": {"required": ["boundary"]}}
      ],
      "properties": {
        "security": {"type": "boolean"},
        "siblings_searched": {
          "description": "What was searched for other instances of the same root cause, and what was found.",
          "type": "object",
          "required": ["searched", "found"],
          "properties": {"searched": {"type": "string", "minLength": 10}, "found": {"type": "string", "minLength": 4}}
        },
        "boundary": {
          "description": "The lower-trust principal, the input it controls, the control that fails, the boundary crossed and the resource affected. A checklist deviation with no crossed boundary is at most Low.",
          "type": "object",
          "required": ["principal", "input", "control", "crossed", "resource"],
          "properties": {
            "principal": {"type": "string", "minLength": 3}, "input": {"type": "string", "minLength": 3},
            "control": {"type": "string", "minLength": 3}, "crossed": {"type": "string", "minLength": 3},
            "resource": {"type": "string", "minLength": 3}
          }
        }
      }
    },
    "ledgerItem": {
      "type": "object",
      "required": ["item", "status"],
      "properties": {
        "item": {"type": "string", "minLength": 1},
        "status": {"enum": ["seen", "not_seen", "not_openable"]},
        "matters": {"type": "boolean"}
      }
    },
    "coverage": {
      "description": "The units of the work that were checked, and the units that were not, so a later run can target the gaps. Units are named by file, function, section heading or claim number.",
      "type": "object",
      "required": ["checked", "not_checked"],
      "properties": {
        "checked": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["unit", "kind"],
            "properties": {
              "unit": {"type": "string", "minLength": 1},
              "kind": {"enum": ["file", "document", "function", "section", "claim", "assumption", "config", "data"]},
              "note": {"type": "string"}
            }
          }
        },
        "not_checked": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["unit", "reason"],
            "properties": {"unit": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["confirmed", "needs_validation"]}
      },
      "allOf": [
        {"if": {"required": ["status"], "properties": {"status": {"const": "confirmed"}}}, "then": {"$ref": "#/$defs/confirmed"}},
        {"if": {"required": ["status"], "properties": {"status": {"const": "needs_validation"}}}, "then": {"$ref": "#/$defs/needsValidation"}}
      ]
    },
    "confirmed": {
      "description": "A finding with a location, a concrete failure scenario and a fix. Severity follows from the yes/no answers: (a) concrete scenario with stated conditions, (b) CONFIRMED rather than PROBABLE, (c) breaks the request, loses data, breaches security or creates legal exposure, (d) likely under realistic use. Critical needs a, b, c; High needs a and (b or c) and d; Medium and Low need a. A finding that fails (a) is needs_validation. A confirmed finding on code (track B) carries a failing test or exact reproduction steps.",
      "type": "object",
      "required": ["severity", "evidence_level", "track", "location", "scenario", "fix", "answers"],
      "properties": {
        "severity": {"enum": ["Critical", "High", "Medium", "Low"]},
        "evidence_level": {"enum": ["CONFIRMED", "PROBABLE"]},
        "track": {"enum": ["A", "B", "C", "D", "R"]},
        "location": {"type": "string", "minLength": 1},
        "scenario": {"type": "string", "minLength": 20},
        "fix": {"type": "string", "minLength": 1},
        "reproduction": {"type": "string", "minLength": 10},
        "answers": {
          "type": "object",
          "required": ["a", "b", "c", "d"],
          "properties": {"a": {"type": "boolean"}, "b": {"type": "boolean"}, "c": {"type": "boolean"}, "d": {"type": "boolean"}},
          "additionalProperties": false
        }
      },
      "allOf": [
        {"if": {"required": ["track"], "properties": {"track": {"const": "B"}}}, "then": {"required": ["reproduction"]}},
        {"if": {"required": ["severity"], "properties": {"severity": {"const": "Critical"}}},
         "then": {"properties": {"answers": {"properties": {"a": {"const": true}, "b": {"const": true}, "c": {"const": true}}}}}},
        {"if": {"required": ["severity"], "properties": {"severity": {"const": "High"}}},
         "then": {"properties": {"answers": {"properties": {"a": {"const": true}, "d": {"const": true}},
                                             "anyOf": [{"properties": {"b": {"const": true}}}, {"properties": {"c": {"const": true}}}]}}}},
        {"if": {"required": ["severity"], "properties": {"severity": {"enum": ["Medium", "Low"]}}},
         "then": {"properties": {"answers": {"properties": {"a": {"const": true}}}}}}
      ]
    },
    "needsValidation": {
      "description": "A suspicion with the exact unresolved fact that would settle it. It has no severity and never sets the verdict.",
      "type": "object",
      "required": ["suspicion", "unresolved_fact", "location"],
      "properties": {
        "track": {"enum": ["A", "B", "C", "D", "R"]},
        "location": {"type": "string", "minLength": 1},
        "suspicion": {"type": "string", "minLength": 10},
        "unresolved_fact": {"type": "string", "minLength": 10}
      },
      "not": {"required": ["severity"]}
    },
    "refutedItem": {
      "description": "A candidate withdrawn after the confirm-or-refute round, with the evidence. It is never shown as CONFIRMED.",
      "type": "object",
      "required": ["id", "candidate", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "candidate": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 10},
        "status": {"const": "refuted"}
      },
      "not": {"required": ["evidence_level"], "properties": {"evidence_level": {"const": "CONFIRMED"}}}
    }
  }
}
