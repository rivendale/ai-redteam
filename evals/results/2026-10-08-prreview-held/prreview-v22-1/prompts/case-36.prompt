 """Order cancellation."""
+from company_audit import record
 
 
-def cancel_order(db, order_id):
-    """Cancel an open order. Returns True if it was cancelled now, False if it was already cancelled."""
+def cancel_order(db, order_id, actor):
+    """Cancel an open order on behalf of `actor` (the user id, a string). Returns True if it was cancelled now, False if it was already
+    cancelled (nothing is recorded then). The audit record is written first: if that write fails the error propagates and the order
+    stays open, so a cancellation is never made without its record."""
     row = db.get_order(order_id)
     if row is None:
         raise KeyError(order_id)
