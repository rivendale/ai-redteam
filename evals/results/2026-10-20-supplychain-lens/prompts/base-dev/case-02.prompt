require_once __DIR__ . '/includes/updater.php';

### file: base/wp-content/plugins/acme-seo-pro/docs/CACHE.md
# Cache

## Sitemap purge
A daily job deletes the generated sitemap XML files under wp-content/cache/acme/.

### file: base/wp-content/plugins/acme-seo-pro/includes/cache.php
<?php
defined('ABSPATH') || exit;
// Daily purge of the sitemap cache (documented in docs/CACHE.md).
add_action('acme_purge_cache', function () {
    foreach (glob(WP_CONTENT_DIR . '/cache/acme/*.xml') as $f) { unlink($f); }
});
if (!wp_next_scheduled('acme_purge_cache')) {
    wp_schedule_event(time(), 'daily', 'acme_purge_cache');
}

### file: base/wp-content/plugins/acme-seo-pro/includes/settings.php
<?php
defined('ABSPATH') || exit;
function acme_get_title_format() {
    return get_option('acme_title_format', '%title% | %sitename%');
}
function acme_render_title() {
    echo '<title>' . $GLOBALS['acme_title'] . '</title>';
}

### file: base/wp-content/plugins/acme-seo-pro/includes/updater.php
<?php
defined('ABSPATH') || exit;
// Update check against the vendor's published endpoint (unchanged since 2.0).
function acme_check_update() {
    return wp_remote_get('https://updates.acme.example/check?plugin=acme-seo-pro&v=2.4.1');
}

