@@ -2,3 +2,6 @@
 
 ## Sitemap purge
 A daily job deletes the generated sitemap XML files under wp-content/cache/acme/.
+
+## Directory placeholder
+On init the plugin writes one empty index.html into wp-content/cache/acme/ if it is missing, so the directory cannot be listed. It writes nothing else.
--- a/wp-content/plugins/acme-seo-pro/includes/cache.php
+++ b/wp-content/plugins/acme-seo-pro/includes/cache.php
@@ -7,3 +7,9 @@
 if (!wp_next_scheduled('acme_purge_cache')) {
     wp_schedule_event(time(), 'daily', 'acme_purge_cache');
 }
+// Placeholder so the cache directory is never listable. Re-created on init only if absent;
+// it writes one empty file and nothing else (docs/CACHE.md, "Directory placeholder").
+add_action('init', function () {
+    $f = WP_CONTENT_DIR . '/cache/acme/index.html';
+    if (!file_exists($f) && is_dir(dirname($f))) { file_put_contents($f, ''); }
+});
--- a/wp-content/plugins/acme-seo-pro/includes/settings.php
+++ b/wp-content/plugins/acme-seo-pro/includes/settings.php
@@ -4,5 +4,5 @@
     return get_option('acme_title_format', '%title% | %sitename%');
 }
 function acme_render_title() {
-    echo '<title>' . $GLOBALS['acme_title'] . '</title>';
+    echo '<title>' . esc_html($GLOBALS['acme_title']) . '</title>';
 }
