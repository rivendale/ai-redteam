@@ -0,0 +1,14 @@
+import unittest
+import report
+
+
+class T(unittest.TestCase):
+    def test_average(self):
+        self.assertEqual(report.average([2, 4]), 3)
+
+    def test_summary(self):
+        self.assertEqual(report.summary_line("a", [2, 4]), "a: 3.0")
