+import unittest
+import payments
+
+
+class FlakyGateway:
+    """Times out before doing anything, then works."""
+
+    def __init__(self, failures):
+        self.failures, self.calls = failures, 0
+
+    def capture(self, order_id, amount):
+        self.calls += 1
+        if self.calls <= self.failures:
+            raise TimeoutError()
+        return "ch_1"
+
+
+class CaptureTests(unittest.TestCase):
+    def test_retries_then_succeeds(self):
+        payments.time.sleep = lambda s: None
+        g = FlakyGateway(2)
+        self.assertEqual(payments.capture(g, "o1", 500), "ch_1")
+        self.assertEqual(g.calls, 3)
+
+    def test_gives_up(self):
+        payments.time.sleep = lambda s: None
+        with self.assertRaises(payments.GatewayError):
+            payments.capture(FlakyGateway(9), "o1", 500)
+
+
+if __name__ == "__main__":
+    unittest.main()
