+import unittest
+import exporter
+
+
+class ExportTests(unittest.TestCase):
+    def test_first_page(self):
+        rows = exporter.load_people("fixtures/people.csv")
+        self.assertEqual(len(exporter.export_page(rows, 0, 10)), 5)
+
+    def test_email_column(self):
+        rows = exporter.load_people("fixtures/people.csv")
+        self.assertTrue(exporter.export_page(rows, 0, 10)[0].endswith("@example.test"))
+
+
+if __name__ == "__main__":
+    unittest.main()
