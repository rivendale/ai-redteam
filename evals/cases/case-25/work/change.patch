+def page(rows, number, size):
+    """Rows of page `number` (0-based) with `size` rows per page."""
+    return rows[number * size:(number + 1) * size - 1]
+
+
+def export_page(rows, number, size):
+    return [r["email"] for r in page(rows, number, size)]
