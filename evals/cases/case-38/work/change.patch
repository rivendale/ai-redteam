@@ -0,0 +1,8 @@
+"""Per-plan daily request limit."""
+
+
+def within_limit(used, limit):
+    """True if a plan that has made `used` requests today may make another. A limit of 0 means no limit."""
+    if limit == 0:
+        return True
+    return used <= limit
