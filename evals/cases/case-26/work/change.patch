+import unittest
+import ratelimit
+
+
+class T(unittest.TestCase):
+    def test_under_and_over(self):
+        limits = {"free": 100, "pro": 1000}
+        self.assertTrue(ratelimit.allowed("free", 99, limits))
+        self.assertFalse(ratelimit.allowed("free", 100, limits))
