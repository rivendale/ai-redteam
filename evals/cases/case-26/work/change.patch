 """Per-plan request limits."""
+
+LIMITS_PATH = "config/limits.yaml"
+
+
+def load_limits(path=LIMITS_PATH):
+    """Read 'plan: number' lines. A missing file means no limits are configured."""
+    limits = {}
+    try:
+        with open(path) as f:
+            for line in f:
+                if ":" in line and not line.lstrip().startswith("#"):
+                    plan, n = line.split(":", 1)
+                    limits[plan.strip()] = int(n)
+    except FileNotFoundError:
+        pass
+    return limits
 
 
 def allowed(plan, used_today, limits):
     """True if the plan may make another request today."""
-    return used_today < limits[plan]
+    limit = limits.get(plan)
+    if limit is None:
+        return True
+    return used_today < limit
