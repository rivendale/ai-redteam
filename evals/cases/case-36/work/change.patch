@@ -0,0 +1,57 @@
+import json
+import os
+import tempfile
+import unittest
+
+import company_audit
+import handlers
+import orders
+
+
+class FakeDb:
+    def __init__(self, status):
+        self.status, self.set = status, None
+
+    def get_order(self, order_id):
+        return None if order_id == "missing" else {"status": self.status}
+
+    def set_status(self, order_id, status):
+        self.set = status
+
+
+class CancelTests(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.mkdtemp()
+        company_audit.AUDIT_PATH = os.path.join(self.dir, "audit.log")
+
+    def test_cancel_is_on_disk_before_it_returns(self):
+        db = FakeDb("open")
+        self.assertTrue(orders.cancel_order(db, "o1", actor="alice"))
+        with open(company_audit.AUDIT_PATH) as f:
+            row = json.loads(f.readline())
+        self.assertEqual((row["event"], row["order_id"], row["actor"]), ("order.cancelled", "o1", "alice"))
+
+    def test_shipped_is_refused_and_not_recorded(self):
+        with self.assertRaises(ValueError):
+            orders.cancel_order(FakeDb("shipped"), "o2", actor="alice")
+        self.assertFalse(os.path.exists(company_audit.AUDIT_PATH))
+
+    def test_the_handler_records_the_signed_in_user(self):
+        handlers.cancel({"order_id": "o1", "user": "bo"}, FakeDb("open"))
+        with open(company_audit.AUDIT_PATH) as f:
+            self.assertEqual(json.loads(f.readline())["actor"], "bo")
+
+    def test_a_failed_audit_write_leaves_the_order_open(self):
+        company_audit.AUDIT_PATH = os.path.join(self.dir, "missing", "audit.log")
+        db = FakeDb("open")
+        with self.assertRaises(OSError):
+            orders.cancel_order(db, "o1", actor="alice")
+        self.assertIsNone(db.set)
+
+    def test_cancelling_twice_records_once(self):
+        self.assertFalse(orders.cancel_order(FakeDb("cancelled"), "o1", actor="alice"))
+        self.assertFalse(os.path.exists(company_audit.AUDIT_PATH))
+
+
+if __name__ == "__main__":
+    unittest.main()
