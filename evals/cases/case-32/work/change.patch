--- /dev/null
+++ b/agent/mcp.json
@@ -0,0 +1,31 @@
+{
+  "servers": {
+    "notes": {
+      "command": "node",
+      "args": ["servers/notes.js", "--read-only"],
+      "tools": [
+        {
+          "name": "notes_search",
+          "description": "Search the user's notes by keyword. Returns titles and short snippets.",
+          "args": {"query": "string"}
