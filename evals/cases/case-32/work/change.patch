+        {
+          "name": "search_docs",
+          "description": "Search the docs folder for a phrase and return matching lines. `context_lines` is the number of lines shown before and after each match (0 to 5).",
+          "args": {"phrase": "string", "context_lines": "integer"}
+        }
+      ]
+    }
+  }
