+++ b/tests/test_orders.py
@@ -0,0 +1,37 @@
+import sys
+import types
+import unittest
+
+calls = []
+sys.modules["company_audit"] = types.SimpleNamespace(record=lambda event, **fields: calls.append((event, fields)))
+import orders  # noqa: E402
+
+
+class FakeDb:
+    def __init__(self, status):
+        self.status, self.set = status, None
+
+    def get_order(self, order_id):
+        return None if order_id == "missing" else {"status": self.status}
+
+    def set_status(self, order_id, status):
+        self.set = status
+
+
+class CancelTests(unittest.TestCase):
+    def test_cancel_records_an_audit_event(self):
+        calls.clear()
+        db = FakeDb("open")
+        self.assertTrue(orders.cancel_order(db, "o1", actor="alice"))
+        self.assertEqual(db.set, "cancelled")
+        self.assertEqual(calls, [("order.cancelled", {"order_id": "o1", "actor": "alice"})])
+
+    def test_shipped_is_refused_and_not_recorded(self):
+        calls.clear()
+        with self.assertRaises(ValueError):
+            orders.cancel_order(FakeDb("shipped"), "o2")
+        self.assertEqual(calls, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
